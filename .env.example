# Database (lokaal Postgres tijdens ontwikkeling; Supabase later te koppelen)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ashi_tashi?schema=public"

# Voice providers — NIET gebruikt in de MVP-mock, alleen voorbereid voor latere koppeling.
# Nooit in frontend-code plaatsen; alleen server-side gebruiken.
TTS_PROVIDER="mock"       # mock | elevenlabs | google | azure
TTS_API_KEY=""

PRONUNCIATION_PROVIDER="mock"  # mock | azure | google
PRONUNCIATION_API_KEY=""

# Feature flags (hfst. 37)
FEATURE_MICROPHONE_ENABLED="true"
FEATURE_OFFLINE_MODE="false"

# Opnamestudio (/studio/opnames) — intern wachtwoord, zie ARCHITECTUUR-OPNAMESTUDIO.md.
# Verplicht instellen (leeg = studio blijft voor iedereen dicht). Draai deze
# tool lokaal (npm run dev), niet op Vercel — zie het architectuurdocument.
STUDIO_PASSWORD=""

# Algemene toegangsgate voor de kind-app zelf (deel-links, zie
# src/lib/shareLink.ts, /studio/deel-link en src/middleware.ts).
# LET OP: het omgekeerde van STUDIO_PASSWORD hierboven — leeg/niet ingesteld
# betekent dat de app gewoon volledig open blijft (zoals voorheen). Vul dit
# pas in als je de app daadwerkelijk achter deel-links wilt zetten: een
# willekeurige lange, geheime string (bv. `openssl rand -hex 32`). Na het
# instellen kun je zelf nog altijd bij de app via een ingelogde studio-sessie
# (STUDIO_PASSWORD) — je sluit jezelf hier niet mee buiten.
SHARE_LINK_SECRET=""
